# ─────────────────────────────────────────────────────────────────────────────
# CloudOps AI — Environment Variables
#
# Copy this file to .env and fill in real values before starting the app.
#
#   cp .env.example .env
#
# .env is listed in .gitignore and will NOT be committed to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth & Security (REQUIRED) ────────────────────────────────────────────────
# Secret key used for signing JWT access tokens.
# The application will refuse to start if SECRET_KEY is missing.
# Generate a long random secret string via:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret_key_generated_by_python_secrets

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# The application will refuse to start if DATABASE_URL is missing.
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/cloudops
POSTGRES_PASSWORD=changeme

# ── AI Providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=30

# ── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

# ── App Settings ─────────────────────────────────────────────────────────────
PROJECT_NAME=CloudOps AI
API_V1_STR=/api/v1
